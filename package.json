{
  "name": "beibu-gulf-webgis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && cd frontend && vite build",
    "dev": "cd frontend && vite",
    "dev:all": "run-p dev dev:server",
    "dev:nest": "npm --prefix backend run start:dev",
    "dev:server": "npm run dev:nest",
    "preview": "cd frontend && vite preview",
    "test": "cd frontend && vitest run",
    "test:watch": "cd frontend && vitest",
    "typecheck": "vue-tsc --noEmit -p frontend/tsconfig.app.json"
  },
  "dependencies": {
    "@sentry/vue": "^11.0.0",
    "cesium": "^1.142.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.2",
    "ol": "^10.9.0",
    "pinia": "^3.0.4",
    "rbush": "^4.0.1",
    "vite-plugin-cesium": "^1.2.23",
    "vue": "^3.5.43",
    "vue-router": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/rbush": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "dompurify": "^3.4.17",
    "fast-uri": "^4.1.4",
    "glob": "^10.5.0",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.23",
    "protobufjs": "^8.7.1",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2",
    "undici": "^7.30.1"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,vue,js,css}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-empty": [
        2,
        "always"
      ]
    }
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "always",
    "endOfLine": "lf",
    "vueIndentScriptAndStyle": false
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11",
    "Chrome >= 89",
    "Safari >= 14.1",
    "Firefox >= 114"
  ]
}