{
  "name": "beibu-gulf-open",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "cd frontend && vite",
    "dev:nest": "npm --prefix backend run start:dev",
    "dev:server": "npm run dev:nest",
    "dev:all": "run-p dev dev:server",
    "build": "npm run typecheck && cd frontend && vite build",
    "preview": "cd frontend && vite preview",
    "test": "cd frontend && vitest run",
    "test:watch": "cd frontend && vitest",
    "typecheck": "vue-tsc --noEmit -p frontend/tsconfig.app.json",
    "typecheck:backend": "npm --prefix backend run build",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"frontend/src/**/*.{css,vue}\""
  },
  "dependencies": {
    "@sentry/vue": "^11.0.0",
    "cesium": "^1.142.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.2",
    "ol": "^10.9.0",
    "pinia": "^3.0.4",
    "rbush": "^4.0.1",
    "vite-plugin-cesium": "^1.2.23",
    "vue": "^3.5.43",
    "vue-router": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/rbush": "^4.0.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "~10.9.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.10",
    "npm-run-all2": "^8.0.4",
    "postcss-html": "^1.7.0",
    "prettier": "3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
